#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

BASE_CONTROL_PORT=12222
BASE_PAC_PORT=12223
INSTANCE_COUNT=0

start_instance() {
	local cfg="$1"
	local enabled secret cdn77_mode cdn77_ip exit_mode exit_country exit_city http_proxy_ip http_proxy_port socks5_ip socks5_port	
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	local current_control_port=$((BASE_CONTROL_PORT + INSTANCE_COUNT))
	local current_pac_port=$((BASE_PAC_PORT + INSTANCE_COUNT))
	INSTANCE_COUNT=$((INSTANCE_COUNT + 1))

	config_get secret "$cfg" secret "ABCD"
	config_get cdn77_mode "$cfg" cdn77_mode "auto"
	config_get cdn77_ip "$cfg" cdn77_ip ""
	config_get exit_mode "$cfg" exit_mode "auto"
	config_get exit_country "$cfg" exit_country "JP"
	config_get exit_city "$cfg" exit_city "Tokyo"
	config_get http_proxy_ip "$cfg" http_proxy_ip "127.0.0.1"
	config_get http_proxy_port "$cfg" http_proxy_port "9910"
	config_get socks5_ip "$cfg" socks5_ip "127.0.0.1"
	config_get socks5_port "$cfg" socks5_port "9909"

	# 创建运行期所需目录
	mkdir -p /var/etc /var/lib/geph/cache /run/geph/engine
	local conf_file="/var/etc/geph5_${cfg}.yaml"

	# 1. 写入头部基础字段与 Bunny 前置 ('0')
	cat <<EOF > "$conf_file"
allow_direct: false
allow_lan: true
broker:
  priority_race:
    '0':
      fronted:
        front: https://fonts.bunny.net/
        host: geph-broker-d5ff98b7.b-cdn.net
        override_dns: null
    '500':
      fronted:
        front: https://www.cdn77.com/
        host: 1826209743.rsc.cdn77.org
EOF

	# 2. 注入 CDN77 的 override_dns
	if [ "$cdn77_mode" = "manual" ] && [ -n "$cdn77_ip" ]; then
		case "$cdn77_ip" in
			*:*) FINAL_CDN_ADDR="$cdn77_ip" ;;
			*) FINAL_CDN_ADDR="${cdn77_ip}:443" ;;
		esac
		echo "        override_dns:" >> "$conf_file"
		echo "        - ${FINAL_CDN_ADDR}" >> "$conf_file"
	else
		echo "        override_dns: null" >> "$conf_file"
	fi

	# 3. 写入 Gcore ('1000') 与 AWS Lambda Bouncer ('1500') 以及公钥指纹
	cat <<EOF >> "$conf_file"
    '1000':
      fronted:
        front: https://gcore.com/
        host: broker-gcore.geph.io
        override_dns: null
    '1500':
      aws_lambda:
        function_name: geph-lambda-bouncer
        obfs_key: 855MJGAMB58MCPJBB97NADJ36D64WM2T:C4TN2M1H68VNMRVCCH57GDV2C5VN6V3RB8QMWP235D0P4RT2ACV7GVTRCHX3EC37
        region: us-east-1
broker_keys:
  master: 88c1d2d4197bed815b01a22cadfc6c35aa246dddb553682037a118aebfaa3954
  mizaru_bw: 
  mizaru_free: 0558216cbab7a9c46f298f4c26e171add9af87d0694988b8a8fe52ee932aa754
  mizaru_plus: cf6f58868c6d9459b3a63bc2bd86165631b3e916bad7f62b578cd9614e0bcb3b
cache: /var/lib/geph/cache/db-${cfg}
control_listen: 127.0.0.1:${current_control_port}
control_listen_pipe: null
control_listen_unix: /run/geph/engine/engine_${cfg}.sock
credentials:
  secret: '${secret}'
dry_run: false
EOF

	# 4. 写入出口区域约束
	if [ "$exit_mode" = "auto" ]; then
		echo "exit_constraint: auto" >> "$conf_file"
	elif [ "$exit_mode" = "country_city" ]; then
		echo "exit_constraint:" >> "$conf_file"
		echo "  country_city:" >> "$conf_file"
		echo "    - \"${exit_country}\"" >> "$conf_file"
		echo "    - \"${exit_city}\"" >> "$conf_file"
	else
		echo "exit_constraint:" >> "$conf_file"
		echo "  country: ${exit_country}" >> "$conf_file"
	fi

	# 5. 写入监听、过滤及隧道回源地址
	cat <<EOF >> "$conf_file"
http_proxy_listen: ${http_proxy_ip}:${http_proxy_port}
pac_listen: 127.0.0.1:${current_pac_port}
passthrough_china: false
port_forward: []
sess_metadata:
  filter:
    ads: false
    nsfw: false
socks5_listen: ${socks5_ip}:${socks5_port}
spoof_dns: false
task_limit: null
tunneled_broker:
  direct: https://broker.geph.io
EOF

	procd_open_instance "$cfg"
	procd_set_param command /usr/bin/geph5-client
	procd_append_param command --config "$conf_file"

	procd_set_param file "$conf_file"
	procd_set_param file /etc/config/geph5

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	mkdir -p /etc/geph5 /var/lib/geph/cache /run/geph/engine
	config_load geph5
	INSTANCE_COUNT=0
	config_foreach start_instance profile
}

service_triggers() {
	procd_add_reload_trigger "geph5"
}
